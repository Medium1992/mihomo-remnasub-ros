#!/bin/sh
# POST с паролем в теле -> md5crypt-хеш ($1$...) для BASIC_AUTH_HASH.
# Ответ: { "ok": bool, "hash": "..." }
. /www/cgi-bin/_remna.sh
require_post

valid_number "${CONTENT_LENGTH:-0}" || deny 'invalid request length'
[ "${CONTENT_LENGTH:-0}" -le 512 ] || deny 'Пароль слишком длинный'
password=$(head -c "${CONTENT_LENGTH:-0}")
[ -n "$password" ] || deny 'Пароль не задан'

hash=$(printf '%s' "$password" | openssl passwd -1 -stdin 2>/dev/null)
case "$hash" in
  '$1$'*) ;;
  *) deny 'OpenSSL не смог создать хеш' ;;
esac

json_headers
printf '{"ok":true,"hash":"%s"}\n' "$hash"
