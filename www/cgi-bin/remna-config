#!/bin/sh
. /www/cgi-bin/_remna.sh

kind=''
profile_id="$ACTIVE_PROFILE_ID"
old_ifs=$IFS
IFS='&'
for pair in ${QUERY_STRING:-}; do
  case "$pair" in
    kind=*) kind=${pair#kind=} ;;
    profile_id=*) profile_id=${pair#profile_id=} ;;
  esac
done
IFS=$old_ifs

valid_profile_id "$profile_id" || profile_id="$ACTIVE_PROFILE_ID"
text_headers
case "$kind" in
  source) file="$PROFILES_DIR/$profile_id.source.yaml" ;;
  final) file="$RUNTIME_DIR/$profile_id.config.yaml" ;;
  # Журналы отдаются только по запросу из открытого окна, а не с каждым
  # опросом состояния.
  events) tail -n 300 "$EVENT_LOG" 2>/dev/null; exit 0 ;;
  core) cat "$RUNTIME_DIR/core.log.1" "$RUNTIME_DIR/core.log" 2>/dev/null | tail -n 400; exit 0 ;;
  *) file='' ;;
esac
[ -n "$file" ] && [ -f "$file" ] && cat "$file"
