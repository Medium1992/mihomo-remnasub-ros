insecure=$(form_value insecure_tls)

case "$url" in ''|http://*|https://*) ;; *) deny 'URL must use http(s)' ;; esac
clean_url=$(printf '%s' "$url" | tr -d '\r\n')
[ "$clean_url" = "$url" ] || deny 'URL must be one line'
[ "${#url}" -le 4096 ] || deny 'URL is too long'
if [ -n "$refresh_minutes" ]; then
  valid_number "$refresh_minutes" && [ "$refresh_minutes" -ge 1 ] && [ "$refresh_minutes" -le 1440 ] || deny 'Refresh interval must be 1..1440 minutes'
  refresh=$((refresh_minutes * 60))
else
  valid_number "$refresh" && [ "$refresh" -ge 30 ] && [ "$refresh" -le 86400 ] || deny 'Refresh interval must be 30..86400 seconds'
fi
valid_number "$timeout" && [ "$timeout" -ge 3 ] && [ "$timeout" -le 120 ] || deny 'Timeout must be 3..120 seconds'
case "$insecure" in 0|1) ;; *) insecure=0 ;; esac
case "$local_override_enabled:$use_provider_title:$use_provider_interval" in [01]:[01]:[01]) ;; *) deny 'invalid local override switches' ;; esac
case "$local_find_process_mode" in inherit|off|strict|always) ;; *) deny 'invalid local find-process-mode' ;; esac
case "$local_log_level" in inherit|silent|error|warning|info|debug) ;; *) deny 'invalid local log-level' ;; esac
case "$local_ipv6" in inherit|0|1) ;; *) deny 'invalid local IPv6 mode' ;; esac
case "$local_store_selected" in inherit|0|1) ;; *) deny 'invalid local store-selected mode' ;; esac
case "$local_store_fake_ip" in inherit|0|1) ;; *) deny 'invalid local store-fake-ip mode' ;; esac
case "$local_sniffer_mode" in inherit|source|disabled) ;; *) deny 'invalid local sniffer mode' ;; esac
clean_headers=$(printf '%s' "$headers" | tr -d '\r')
