    tproxy_port=$(form_value tproxy_port)
    ui_preset=$(form_value external_ui_preset)
    ui_url=$(form_value external_ui_url)
    ui_secret=$(form_value external_ui_secret)
    mihomo_find_process_mode=$(form_value mihomo_find_process_mode)
    mihomo_log_level=$(form_value mihomo_log_level)
    mihomo_ipv6=$(form_value mihomo_ipv6)
    mihomo_store_selected=$(form_value mihomo_store_selected)
    mihomo_store_fake_ip=$(form_value mihomo_store_fake_ip)
    mihomo_sniffer_override=$(form_value mihomo_sniffer_override)
    mihomo_sniffer_enable=$(form_value mihomo_sniffer_enable)
    mihomo_sniffer_force_dns_mapping=$(form_value mihomo_sniffer_force_dns_mapping)
    mihomo_sniffer_parse_pure_ip=$(form_value mihomo_sniffer_parse_pure_ip)
    mihomo_sniffer_override_destination=$(form_value mihomo_sniffer_override_destination)
    mihomo_sniffer_quic_ports=$(form_value mihomo_sniffer_quic_ports)
    mihomo_sniffer_tls_ports=$(form_value mihomo_sniffer_tls_ports)
    mihomo_sniffer_http_ports=$(form_value mihomo_sniffer_http_ports)
    mihomo_sniffer_http_override_destination=$(form_value mihomo_sniffer_http_override_destination)
    mihomo_sniffer_force_domain=$(form_value mihomo_sniffer_force_domain)
    mihomo_sniffer_skip_domain=$(form_value mihomo_sniffer_skip_domain)
    mihomo_sniffer_skip_src_address=$(form_value mihomo_sniffer_skip_src_address)
    mihomo_sniffer_skip_dst_address=$(form_value mihomo_sniffer_skip_dst_address)
    network_disable_ipv6=$(form_value network_disable_ipv6)
    network_qdisc=$(form_value network_qdisc)
    network_disable_multicast=$(form_value network_disable_multicast)
    network_ct_established=$(form_value network_ct_established)
    network_ct_syn_sent=$(form_value network_ct_syn_sent)
    network_ct_syn_recv=$(form_value network_ct_syn_recv)
    network_ct_fin_wait=$(form_value network_ct_fin_wait)
    network_ct_close_wait=$(form_value network_ct_close_wait)
    network_ct_last_ack=$(form_value network_ct_last_ack)
    network_ct_time_wait=$(form_value network_ct_time_wait)
    network_ct_close=$(form_value network_ct_close)
    network_ct_unacknowledged=$(form_value network_ct_unacknowledged)
    network_ct_udp_stream=$(form_value network_ct_udp_stream)
    web_theme=$(form_value web_theme)
    web_accent=$(form_value web_accent)
    global_headers=$(printf '%s' "$global_headers" | tr -d '\r')
    [ "${#global_headers}" -le 16384 ] || deny 'Global headers are too large'
    valid_header_block "$global_headers" || deny 'Global headers contain an invalid or duplicate name'
    case "$listener_mode" in auto|redir-tun|redir-tproxy|tproxy) ;; *) deny 'invalid listener mode' ;; esac
    valid_number "$redir_port" && [ "$redir_port" -ge 1 ] && [ "$redir_port" -le 65535 ] || deny 'REDIR port must be 1..65535'
    valid_number "$tproxy_port" && [ "$tproxy_port" -ge 1 ] && [ "$tproxy_port" -le 65535 ] || deny 'TPROXY port must be 1..65535'
    combined_ports=0
    [ "$listener_mode" = redir-tproxy ] && combined_ports=1
    if [ "$listener_mode" = auto ] && grep -q '^nf_tables ' /proc/modules 2>/dev/null; then combined_ports=1; fi
    [ "$combined_ports" = 0 ] || [ "$redir_port" != "$tproxy_port" ] || deny 'REDIR and TPROXY ports must be different in combined mode'
    case "$ui_preset" in zashboard|zashboard-cdn|metacubexd|yacd-meta|custom) ;; *) deny 'invalid Mihomo panel preset' ;; esac
    ui_url=$(printf '%s' "$ui_url" | tr -d '\r\n')
    [ "${#ui_url}" -le 2048 ] || deny 'Mihomo panel URL is too long'
    if [ "$ui_preset" = custom ]; then
      case "$ui_url" in http://*|https://*) ;; *) deny 'Mihomo panel URL must use http(s)' ;; esac
    fi
    clean_secret=$(printf '%s' "$ui_secret" | tr -d '\r\n')
    [ "$clean_secret" = "$ui_secret" ] || deny 'Mihomo panel password must be one line'
    [ "${#ui_secret}" -le 512 ] || deny 'Mihomo panel password is too long'
    case "$mihomo_find_process_mode" in off|strict|always) ;; *) deny 'invalid find-process-mode' ;; esac
    case "$mihomo_log_level" in silent|error|warning|info|debug) ;; *) deny 'invalid log-level' ;; esac
    case "$mihomo_ipv6:$mihomo_store_selected:$mihomo_store_fake_ip" in [01]:[01]:[01]) ;; *) deny 'invalid Mihomo switches' ;; esac
    case "$mihomo_sniffer_override:$mihomo_sniffer_enable:$mihomo_sniffer_force_dns_mapping:$mihomo_sniffer_parse_pure_ip:$mihomo_sniffer_override_destination:$mihomo_sniffer_http_override_destination" in
      [01]:[01]:[01]:[01]:[01]:[01]) ;;
      *) deny 'invalid sniffer switches' ;;
    esac
    mihomo_sniffer_quic_ports=$(printf '%s' "$mihomo_sniffer_quic_ports" | tr -d '\r')
    mihomo_sniffer_tls_ports=$(printf '%s' "$mihomo_sniffer_tls_ports" | tr -d '\r')
    mihomo_sniffer_http_ports=$(printf '%s' "$mihomo_sniffer_http_ports" | tr -d '\r')
    mihomo_sniffer_force_domain=$(printf '%s' "$mihomo_sniffer_force_domain" | tr -d '\r')
    mihomo_sniffer_skip_domain=$(printf '%s' "$mihomo_sniffer_skip_domain" | tr -d '\r')
    mihomo_sniffer_skip_src_address=$(printf '%s' "$mihomo_sniffer_skip_src_address" | tr -d '\r')
    mihomo_sniffer_skip_dst_address=$(printf '%s' "$mihomo_sniffer_skip_dst_address" | tr -d '\r')
    [ "${#mihomo_sniffer_quic_ports}" -le 4096 ] && [ "${#mihomo_sniffer_tls_ports}" -le 4096 ] && [ "${#mihomo_sniffer_http_ports}" -le 4096 ] || deny 'Sniffer port list is too large'
    valid_port_block "$mihomo_sniffer_quic_ports" && valid_port_block "$mihomo_sniffer_tls_ports" && valid_port_block "$mihomo_sniffer_http_ports" || deny 'Sniffer ports must be 1..65535 or ranges'
    [ "${#mihomo_sniffer_force_domain}" -le 16384 ] && [ "${#mihomo_sniffer_skip_domain}" -le 16384 ] && [ "${#mihomo_sniffer_skip_src_address}" -le 16384 ] && [ "${#mihomo_sniffer_skip_dst_address}" -le 16384 ] || deny 'Sniffer list is too large'
    case "$network_disable_ipv6:$network_disable_multicast" in [01]:[01]) ;; *) deny 'invalid Alpine network switches' ;; esac
    case "$network_qdisc" in fq_codel|cake|codel|sfq|pfifo|bfifo|system) ;; *) deny 'invalid qdisc mode' ;; esac
    case "$web_theme" in auto|dark|light|graphite|midnight|forest|sepia) ;; *) deny 'invalid web theme' ;; esac
    case "$web_accent" in
      '') ;;
      '#'[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
      *) deny 'Accent colour must be #rrggbb' ;;
    esac
    for network_timeout in "$network_ct_established" "$network_ct_syn_sent" "$network_ct_syn_recv" "$network_ct_fin_wait" "$network_ct_close_wait" "$network_ct_last_ack" "$network_ct_time_wait" "$network_ct_close" "$network_ct_unacknowledged" "$network_ct_udp_stream"; do
      valid_number "$network_timeout" && [ "$network_timeout" -ge 1 ] && [ "$network_timeout" -le 604800 ] || deny 'conntrack timeouts must be 1..604800 seconds'
    done
    panel_settings_changed=false
    [ "$ST_EXTERNAL_UI_PRESET" = "$ui_preset" ] || panel_settings_changed=true
    b64_text_matches "$ST_EXTERNAL_UI_URL_B64" "$ui_url" || panel_settings_changed=true

    runtime_settings_changed=false
    [ "$ST_LISTENER_MODE" = "$listener_mode" ] || runtime_settings_changed=true
    [ "$ST_REDIR_PORT" = "$redir_port" ] || runtime_settings_changed=true
    [ "$ST_TPROXY_PORT" = "$tproxy_port" ] || runtime_settings_changed=true
    b64_text_matches "$ST_EXTERNAL_UI_SECRET_B64" "$ui_secret" || runtime_settings_changed=true
    [ "$ST_MIHOMO_FIND_PROCESS_MODE" = "$mihomo_find_process_mode" ] || runtime_settings_changed=true
    [ "$ST_MIHOMO_LOG_LEVEL" = "$mihomo_log_level" ] || runtime_settings_changed=true
    [ "$ST_MIHOMO_IPV6" = "$mihomo_ipv6" ] || runtime_settings_changed=true
    [ "$ST_MIHOMO_STORE_SELECTED" = "$mihomo_store_selected" ] || runtime_settings_changed=true
    [ "$ST_MIHOMO_STORE_FAKE_IP" = "$mihomo_store_fake_ip" ] || runtime_settings_changed=true

    old_sniffer_override="$ST_MIHOMO_SNIFFER_OVERRIDE"
    [ "$old_sniffer_override" = "$mihomo_sniffer_override" ] || runtime_settings_changed=true
    if [ "$old_sniffer_override" = 1 ] || [ "$mihomo_sniffer_override" = 1 ]; then
      [ "$ST_MIHOMO_SNIFFER_ENABLE" = "$mihomo_sniffer_enable" ] || runtime_settings_changed=true
      [ "$ST_MIHOMO_SNIFFER_FORCE_DNS_MAPPING" = "$mihomo_sniffer_force_dns_mapping" ] || runtime_settings_changed=true
      [ "$ST_MIHOMO_SNIFFER_PARSE_PURE_IP" = "$mihomo_sniffer_parse_pure_ip" ] || runtime_settings_changed=true
      [ "$ST_MIHOMO_SNIFFER_OVERRIDE_DESTINATION" = "$mihomo_sniffer_override_destination" ] || runtime_settings_changed=true
      b64_ports_match "$ST_MIHOMO_SNIFFER_QUIC_PORTS_B64" "$mihomo_sniffer_quic_ports" || runtime_settings_changed=true
      b64_ports_match "$ST_MIHOMO_SNIFFER_TLS_PORTS_B64" "$mihomo_sniffer_tls_ports" || runtime_settings_changed=true
      b64_ports_match "$ST_MIHOMO_SNIFFER_HTTP_PORTS_B64" "$mihomo_sniffer_http_ports" || runtime_settings_changed=true
      [ "$ST_MIHOMO_SNIFFER_HTTP_OVERRIDE_DESTINATION" = "$mihomo_sniffer_http_override_destination" ] || runtime_settings_changed=true
      b64_text_matches "$ST_MIHOMO_SNIFFER_FORCE_DOMAIN_B64" "$mihomo_sniffer_force_domain" || runtime_settings_changed=true
      b64_text_matches "$ST_MIHOMO_SNIFFER_SKIP_DOMAIN_B64" "$mihomo_sniffer_skip_domain" || runtime_settings_changed=true
      b64_text_matches "$ST_MIHOMO_SNIFFER_SKIP_SRC_ADDRESS_B64" "$mihomo_sniffer_skip_src_address" || runtime_settings_changed=true
      b64_text_matches "$ST_MIHOMO_SNIFFER_SKIP_DST_ADDRESS_B64" "$mihomo_sniffer_skip_dst_address" || runtime_settings_changed=true
    fi
    write_container_settings
    panel_update=false
    core_rebuild=false
    source_refresh=false
    if [ "$panel_settings_changed" = true ]; then
      queue_panel_update
      panel_update=true
    fi
    active_id="${ST_ACTIVE_PROFILE_ID:-$ACTIVE_PROFILE_ID}"
    if [ "$runtime_settings_changed" = true ] && [ -s "$PROFILES_DIR/$active_id.source.yaml" ]; then
      queue_profile_job "$active_id" rebuild "global settings changed"
      core_rebuild=true
    fi
    json_headers
    printf '{"ok":true,"action":"save-settings","panel_update":%s,"core_rebuild":%s,"source_refresh":%s}\n' "$panel_update" "$core_rebuild" "$source_refresh"
    exit 0
    ;;
esac

target_id=$(form_value profile_id)
active_id="${ST_ACTIVE_PROFILE_ID:-$ACTIVE_PROFILE_ID}"
[ -n "$target_id" ] || target_id="$active_id"
target_path=$(profile_file "$target_id") || deny 'invalid profile id'
[ -f "$target_path" ] || deny 'profile not found'
profile_load "$target_path"
old_fetch_signature="$P_SUB_URL_B64|$P_SUB_HEADERS_B64|$P_SUB_TIMEOUT_SECONDS|$P_SUB_INSECURE_TLS"
old_build_signature="$P_LOCAL_OVERRIDE_ENABLED|$P_LOCAL_OVERRIDE_B64|$P_LOCAL_FIND_PROCESS_MODE|$P_LOCAL_LOG_LEVEL|$P_LOCAL_IPV6|$P_LOCAL_STORE_SELECTED|$P_LOCAL_STORE_FAKE_IP|$P_LOCAL_SNIFFER_MODE"
