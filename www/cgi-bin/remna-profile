#!/bin/sh
. /www/cgi-bin/_remna.sh

profile_local_override_enabled() {
  local_file="$1"
  local_enabled=$(state_file_get "$local_file" LOCAL_OVERRIDE_ENABLED missing)
  if [ "$local_enabled" = missing ]; then
    [ -n "$(state_file_get "$local_file" LOCAL_OVERRIDE_B64)" ] && local_enabled=1 || local_enabled=0
  fi
  case "$local_enabled" in 0|1) ;; *) local_enabled=0 ;; esac
  printf '%s' "$local_enabled"
}

profile_meta_get() {
  meta_file="$1" meta_key="$2" meta_fallback="${3:-}"
  state_file_get "$meta_file" "$meta_key" "$meta_fallback"
}

profile_effective_name_b64() {
  effective_file="$1" effective_meta="$2"
  local_name=$(state_file_get "$effective_file" NAME_B64 "$(b64 "${effective_file##*/}")")
  use_provider_title=$(state_file_get "$effective_file" SUB_USE_PROVIDER_TITLE 1)
  provider_title=$(profile_meta_get "$effective_meta" provider_title_b64)
  if [ "$use_provider_title" = 1 ] && [ -n "$provider_title" ]; then
    printf '%s' "$provider_title"
  else
    printf '%s' "$local_name"
  fi
}

profile_effective_refresh() {
  effective_file="$1" effective_meta="$2"
  refresh=$(state_file_get "$effective_file" SUB_REFRESH_SECONDS 3600)
  valid_number "$refresh" && [ "$refresh" -ge 30 ] && [ "$refresh" -le 86400 ] || refresh=3600
  if [ "$(state_file_get "$effective_file" SUB_USE_PROVIDER_INTERVAL 1)" = 1 ]; then
    provider_refresh=$(profile_meta_get "$effective_meta" provider_refresh_seconds)
    if valid_number "$provider_refresh" && [ "$provider_refresh" -ge 30 ] && [ "$provider_refresh" -le 86400 ]; then
      refresh="$provider_refresh"
    fi
  fi
  printf '%s' "$refresh"
}

number_or() {
  number_value="$1" number_fallback="$2"
  valid_number "$number_value" && printf '%s' "$number_value" || printf '%s' "$number_fallback"
}

bool_or() {
  bool_value="$1" bool_fallback="$2"
  case "$bool_value" in 0|1) printf '%s' "$bool_value" ;; *) printf '%s' "$bool_fallback" ;; esac
}

valid_header_block() {
  printf '%s\n' "${1:-}" | awk '
    function trim(value) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); return value }
    {
      sub(/\r$/, "")
      if ($0 ~ /^[[:space:]]*$/) next
      separator = index($0, ":")
      if (separator < 2) exit 1
      key = trim(substr($0, 1, separator - 1))
      if (key !~ /^[A-Za-z0-9-]+$/) exit 1
      key = tolower(key)
      if (seen[key]++) exit 1
    }
  '
}

sniffer_override_value() {
  configured=$(state_file_get "$STATE" MIHOMO_SNIFFER_OVERRIDE)
  case "$configured" in 0|1) printf '%s' "$configured"; return 0 ;; esac
  printf '0'
}

valid_port_block() {
  printf '%s' "${1:-}" | tr ',' '\n' | awk '
    function trim(value) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); return value }
    {
      value=trim($0)
      if (value == "") next
      if (value ~ /^[0-9]+$/) {
        number=value + 0
        if (number < 1 || number > 65535) exit 1
        next
      }
      if (value ~ /^[0-9]+-[0-9]+$/) {
        split(value, range, "-")
        start=range[1] + 0
        finish=range[2] + 0
        if (start < 1 || finish > 65535 || start > finish) exit 1
        next
      }
      exit 1
    }
  '
}

decode_b64_value() {
  [ -n "${1:-}" ] || return 0
  printf '%s' "$1" | openssl base64 -d -A 2>/dev/null
}

canonical_ports() {
  printf '%s' "${1:-}" | tr ',' '\n' | awk '
    function trim(value) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); return value }
    {
      value=trim($0)
      if (value == "") next
      if (result != "") result=result ","
      result=result value
    }
    END { printf "%s", result }
  '
}

state_scalar_matches() {
  [ "$(state_file_get "$STATE" "$1" "$2")" = "$3" ]
}

state_b64_text_matches() (
  compare_stored=$(decode_b64_value "$(state_file_get "$STATE" "$1" "$2")" | tr -d '\r')
  compare_submitted=$(printf '%s' "$3" | tr -d '\r')
  [ "$compare_stored" = "$compare_submitted" ]
)

state_b64_ports_match() (
  compare_stored=$(canonical_ports "$(decode_b64_value "$(state_file_get "$STATE" "$1" "$2")")")
  compare_submitted=$(canonical_ports "$3")
  [ "$compare_stored" = "$compare_submitted" ]
)

profiles_json() {
  first=1
  for file in "$PROFILES_DIR"/p-*.conf; do
    [ -f "$file" ] || continue
    id=${file##*/}
    id=${id%.conf}
    profile_source="$PROFILES_DIR/$id.source.yaml"
    profile_final="$RUNTIME_DIR/$id.config.yaml"
    profile_error="$ERRORS_DIR/$id.txt"
    profile_meta="$PROFILES_DIR/$id.source.meta"
    source_present=false
    final_present=false
    updated_at=0
    final_updated_at=0
    [ -s "$profile_source" ] && source_present=true
    [ -s "$profile_final" ] && final_present=true
    if [ -f "$profile_source" ]; then
      updated_at=$(profile_meta_get "$profile_meta" fetched_epoch 0)
      valid_number "$updated_at" || updated_at=$(stat -c '%Y' "$profile_source" 2>/dev/null || printf '0')
    fi
    if [ -f "$profile_final" ]; then
      final_updated_at=$(stat -c '%Y' "$profile_final" 2>/dev/null || printf '0')
    fi
    refresh_state=$(profile_status_get "$id" STATE idle)
    refresh_stage=$(profile_status_get "$id" STAGE idle)
    refresh_action=$(profile_status_get "$id" ACTION)
    [ -f "$JOBS_DIR/$id.request" ] && refresh_state=queued refresh_stage=queued
    refresh_http_status=$(profile_status_get "$id" HTTP_STATUS)
    refresh_bytes=$(profile_status_get "$id" BYTES 0)
    refresh_started=$(profile_status_get "$id" STARTED_EPOCH 0)
    refresh_finished=$(profile_status_get "$id" FINISHED_EPOCH 0)
    valid_number "$refresh_bytes" || refresh_bytes=0
    valid_number "$refresh_started" || refresh_started=0
    valid_number "$refresh_finished" || refresh_finished=0
    [ "$first" = 1 ] || printf ','
    first=0
    printf '{"id":"%s","name_b64":"%s","display_name_b64":"%s","url_b64":"%s","refresh_seconds":%s,"effective_refresh_seconds":%s,"local_override_enabled":%s,"source_present":%s,"final_present":%s,"updated_at":%s,"final_updated_at":%s,"configuration_valid":"%s","subscription_userinfo_b64":"%s","zero_vless_count":%s,"zero_vless_entries_b64":"%s","refresh_state":"%s","refresh_stage":"%s","refresh_action":"%s","refresh_http_status":"%s","refresh_http_line_b64":"%s","refresh_bytes":%s,"refresh_started_at":%s,"refresh_finished_at":%s,"refresh_message_b64":"%s","refresh_validation_b64":"%s","error_b64":"%s"}' \
      "$id" \
      "$(state_file_get "$file" NAME_B64 "$(b64 "$id")")" \
      "$(profile_effective_name_b64 "$file" "$profile_meta")" \
      "$(state_file_get "$file" SUB_URL_B64)" \
      "$(number_or "$(state_file_get "$file" SUB_REFRESH_SECONDS 3600)" 3600)" \
      "$(profile_effective_refresh "$file" "$profile_meta")" \
      "$(profile_local_override_enabled "$file")" \
      "$source_present" \
      "$final_present" \
      "$updated_at" \
      "$final_updated_at" \
      "$(profile_meta_get "$profile_meta" configuration_valid unknown)" \
      "$(profile_meta_get "$profile_meta" subscription_userinfo_b64)" \
      "$(number_or "$(profile_meta_get "$profile_meta" zero_vless_count)" 0)" \
      "$(profile_meta_get "$profile_meta" zero_vless_entries_b64)" \
      "$refresh_state" \
      "$refresh_stage" \
      "$refresh_action" \
      "$refresh_http_status" \
      "$(profile_status_get "$id" HTTP_STATUS_LINE_B64)" \
      "$refresh_bytes" \
      "$refresh_started" \
      "$refresh_finished" \
      "$(profile_status_get "$id" MESSAGE_B64)" \
      "$(profile_status_get "$id" VALIDATION_B64)" \
      "$(b64 "$(cat "$profile_error" 2>/dev/null || true)")"
  done
}

query_value() {
  query_key="$1"
  printf '%s' "${QUERY_STRING:-}" | tr '&' '\n' | awk -F= -v key="$query_key" '
    $1 == key { sub(/^[^=]*=/, ""); print; exit }
  '
}

profile_detail_json() (
  view_id="$1"
  view_path=$(profile_file "$view_id") || return 1
  view_source="$PROFILES_DIR/$view_id.source.yaml"
  view_final="$RUNTIME_DIR/$view_id.config.yaml"
  view_error="$ERRORS_DIR/$view_id.txt"
  view_meta="$PROFILES_DIR/$view_id.source.meta"
  view_source_present=false
  view_final_present=false
  view_updated_at=0
  [ -s "$view_source" ] && view_source_present=true
  [ -s "$view_final" ] && view_final_present=true
  if [ -f "$view_source" ]; then
    view_updated_at=$(profile_meta_get "$view_meta" fetched_epoch 0)
    valid_number "$view_updated_at" || view_updated_at=$(stat -c '%Y' "$view_source" 2>/dev/null || printf '0')
  fi

  printf '{'
  printf '"id":"%s",' "$view_id"
  printf '"name_b64":"%s",' "$(state_file_get "$view_path" NAME_B64 "$(b64 "$view_id")")"
  printf '"display_name_b64":"%s",' "$(profile_effective_name_b64 "$view_path" "$view_meta")"
  printf '"url_b64":"%s",' "$(state_file_get "$view_path" SUB_URL_B64)"
  printf '"headers_b64":"%s",' "$(state_file_get "$view_path" SUB_HEADERS_B64)"
  printf '"local_override_enabled":%s,' "$(profile_local_override_enabled "$view_path")"
  printf '"local_override_b64":"%s",' "$(state_file_get "$view_path" LOCAL_OVERRIDE_B64)"
  printf '"local_find_process_mode":"%s",' "$(state_file_get "$view_path" LOCAL_FIND_PROCESS_MODE inherit)"
  printf '"local_log_level":"%s",' "$(state_file_get "$view_path" LOCAL_LOG_LEVEL inherit)"
  printf '"local_ipv6":"%s",' "$(state_file_get "$view_path" LOCAL_IPV6 inherit)"
  printf '"local_store_selected":"%s",' "$(state_file_get "$view_path" LOCAL_STORE_SELECTED inherit)"
  printf '"local_store_fake_ip":"%s",' "$(state_file_get "$view_path" LOCAL_STORE_FAKE_IP inherit)"
  printf '"local_sniffer_mode":"%s",' "$(state_file_get "$view_path" LOCAL_SNIFFER_MODE inherit)"
  printf '"use_provider_title":%s,' "$(bool_or "$(state_file_get "$view_path" SUB_USE_PROVIDER_TITLE 1)" 1)"
  printf '"use_provider_interval":%s,' "$(bool_or "$(state_file_get "$view_path" SUB_USE_PROVIDER_INTERVAL 1)" 1)"
  printf '"refresh_seconds":%s,' "$(number_or "$(state_file_get "$view_path" SUB_REFRESH_SECONDS 3600)" 3600)"
  printf '"effective_refresh_seconds":%s,' "$(profile_effective_refresh "$view_path" "$view_meta")"
  printf '"timeout_seconds":%s,' "$(number_or "$(state_file_get "$view_path" SUB_TIMEOUT_SECONDS 30)" 30)"
  printf '"insecure_tls":%s,' "$(bool_or "$(state_file_get "$view_path" SUB_INSECURE_TLS 0)" 0)"
  printf '"provider_title_b64":"%s",' "$(profile_meta_get "$view_meta" provider_title_b64)"
  printf '"provider_refresh_seconds":%s,' "$(number_or "$(profile_meta_get "$view_meta" provider_refresh_seconds)" 0)"
  printf '"subscription_userinfo_b64":"%s",' "$(profile_meta_get "$view_meta" subscription_userinfo_b64)"
  printf '"profile_web_page_url_b64":"%s",' "$(profile_meta_get "$view_meta" profile_web_page_url_b64)"
  printf '"support_url_b64":"%s",' "$(profile_meta_get "$view_meta" support_url_b64)"
  printf '"subscription_refill_date_b64":"%s",' "$(profile_meta_get "$view_meta" subscription_refill_date_b64)"
  printf '"announce_b64":"%s",' "$(profile_meta_get "$view_meta" announce_b64)"
  printf '"source_present":%s,' "$view_source_present"
  printf '"final_present":%s,' "$view_final_present"
  printf '"updated_at":%s,' "$view_updated_at"
  printf '"final_updated_at":%s,' "$(stat -c '%Y' "$view_final" 2>/dev/null || printf '0')"
  printf '"configuration_valid":"%s",' "$(profile_meta_get "$view_meta" configuration_valid unknown)"
  printf '"http_status":"%s",' "$(profile_meta_get "$view_meta" http_status)"
  printf '"http_status_line_b64":"%s",' "$(profile_meta_get "$view_meta" http_status_line_b64)"
  printf '"validation_b64":"%s",' "$(profile_meta_get "$view_meta" validation_b64)"
  printf '"zero_vless_count":%s,' "$(number_or "$(profile_meta_get "$view_meta" zero_vless_count)" 0)"
  printf '"zero_vless_entries_b64":"%s",' "$(profile_meta_get "$view_meta" zero_vless_entries_b64)"
  printf '"error_b64":"%s"' "$(b64 "$(cat "$view_error" 2>/dev/null || true)")"
  printf '}'
)

