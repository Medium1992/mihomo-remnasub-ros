#!/bin/sh
. /www/cgi-bin/_remna.sh

# Профиль и его метаданные загружаются парой: имя и интервал показываются
# либо свои, либо присланные провайдером подписки.
profile_bundle_load() {
  bundle_id="$1"
  profile_load "$PROFILES_DIR/$bundle_id.conf"
  meta_load "$PROFILES_DIR/$bundle_id.source.meta"
  status_load "$bundle_id"
}

effective_name_b64() {
  if [ "$P_SUB_USE_PROVIDER_TITLE" = 1 ] && [ -n "$M_provider_title_b64" ]; then
    printf '%s' "$M_provider_title_b64"
  elif [ -n "$P_NAME_B64" ]; then
    printf '%s' "$P_NAME_B64"
  else
    b64 "$1"
  fi
}

effective_refresh() {
  refresh="$P_SUB_REFRESH_SECONDS"
  valid_number "$refresh" && [ "$refresh" -ge 30 ] && [ "$refresh" -le 86400 ] || refresh=3600
  if [ "$P_SUB_USE_PROVIDER_INTERVAL" = 1 ] && [ -n "$M_provider_refresh_seconds" ]; then
    if [ "$M_provider_refresh_seconds" -ge 30 ] && [ "$M_provider_refresh_seconds" -le 86400 ]; then
      refresh="$M_provider_refresh_seconds"
    fi
  fi
  printf '%s' "$refresh"
}

number_or() {
  valid_number "$1" && printf '%s' "$1" || printf '%s' "$2"
}

bool_or() {
  case "$1" in 0|1) printf '%s' "$1" ;; *) printf '%s' "$2" ;; esac
}

valid_header_block() {
  printf '%s\n' "${1:-}" | awk '
    function trim(value) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); return value }
    {
      sub(/\r$/, "")
      if ($0 ~ /^[[:space:]]*$/) next
      separator = index($0, ":")
      if (separator < 2) exit 1
      key = trim(substr($0, 1, separator - 1))
      if (key !~ /^[A-Za-z0-9-]+$/) exit 1
      key = tolower(key)
      if (seen[key]++) exit 1
    }
  '
}

valid_port_block() {
  printf '%s' "${1:-}" | tr ',' '\n' | awk '
    function trim(value) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); return value }
    {
      value=trim($0)
      if (value == "") next
      if (value ~ /^[0-9]+$/) {
        number=value + 0
        if (number < 1 || number > 65535) exit 1
        next
      }
      if (value ~ /^[0-9]+-[0-9]+$/) {
        split(value, range, "-")
        start=range[1] + 0
        finish=range[2] + 0
        if (start < 1 || finish > 65535 || start > finish) exit 1
        next
      }
      exit 1
    }
  '
}

canonical_ports() {
  printf '%s' "${1:-}" | tr ',' '\n' | awk '
    function trim(value) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); return value }
    {
      value=trim($0)
      if (value == "") next
      if (result != "") result=result ","
      result=result value
    }
    END { printf "%s", result }
  '
}

b64_text_matches() {
  [ "$(b64_decode "$1" | tr -d '\r')" = "$(printf '%s' "$2" | tr -d '\r')" ]
}

b64_ports_match() {
  [ "$(canonical_ports "$(b64_decode "$1")")" = "$(canonical_ports "$2")" ]
}

profiles_json() {
  first=1
  for file in "$PROFILES_DIR"/p-*.conf; do
    [ -f "$file" ] || continue
    id=${file##*/}
    id=${id%.conf}
    valid_profile_id "$id" || continue
    profile_bundle_load "$id"
    profile_source="$PROFILES_DIR/$id.source.yaml"
    profile_final="$RUNTIME_DIR/$id.config.yaml"
    profile_error="$ERRORS_DIR/$id.txt"
    source_present=false
    final_present=false
    updated_at=0
    final_updated_at=0
    [ -s "$profile_source" ] && source_present=true
    [ -s "$profile_final" ] && final_present=true
    if [ -f "$profile_source" ]; then
      updated_at="$M_fetched_epoch"
      [ "$updated_at" != 0 ] || updated_at=$(stat -c '%Y' "$profile_source" 2>/dev/null || printf '0')
      valid_number "$updated_at" || updated_at=0
    fi
    if [ -f "$profile_final" ]; then
      final_updated_at=$(stat -c '%Y' "$profile_final" 2>/dev/null || printf '0')
      valid_number "$final_updated_at" || final_updated_at=0
    fi
    refresh_state="$S_STATE"
    refresh_stage="$S_STAGE"
    [ -f "$JOBS_DIR/$id.request" ] && refresh_state=queued refresh_stage=queued
    [ "$first" = 1 ] || printf ','
    first=0
    printf '{"id":"%s","name_b64":"%s","display_name_b64":"%s","url_b64":"%s","refresh_seconds":%s,"effective_refresh_seconds":%s,"local_override_enabled":%s,"source_present":%s,"final_present":%s,"updated_at":%s,"final_updated_at":%s,"configuration_valid":"%s","subscription_userinfo_b64":"%s","zero_vless_count":%s,"zero_vless_entries_b64":"%s","refresh_state":"%s","refresh_stage":"%s","refresh_action":"%s","refresh_http_status":"%s","refresh_http_line_b64":"%s","refresh_bytes":%s,"refresh_started_at":%s,"refresh_finished_at":%s,"refresh_message_b64":"%s","refresh_validation_b64":"%s","error_b64":"%s"}' \
      "$id" \
      "${P_NAME_B64:-$(b64 "$id")}" \
      "$(effective_name_b64 "$id")" \
      "$P_SUB_URL_B64" \
      "$(number_or "$P_SUB_REFRESH_SECONDS" 3600)" \
      "$(effective_refresh)" \
      "$P_LOCAL_OVERRIDE_ENABLED" \
      "$source_present" \
      "$final_present" \
      "$updated_at" \
      "$final_updated_at" \
      "$M_configuration_valid" \
      "$M_subscription_userinfo_b64" \
      "$M_zero_vless_count" \
      "$M_zero_vless_entries_b64" \
      "$refresh_state" \
      "$refresh_stage" \
      "$S_ACTION" \
      "$S_HTTP_STATUS" \
      "$S_HTTP_STATUS_LINE_B64" \
      "$S_BYTES" \
      "$S_STARTED_EPOCH" \
      "$S_FINISHED_EPOCH" \
      "$S_MESSAGE_B64" \
      "$S_VALIDATION_B64" \
      "$(b64 "$(cat "$profile_error" 2>/dev/null || true)")"
  done
}

query_value() {
  query_wanted="$1"
  query_rest="${QUERY_STRING:-}"
  while [ -n "$query_rest" ]; do
    case "$query_rest" in
      *'&'*) query_pair="${query_rest%%&*}"; query_rest="${query_rest#*&}" ;;
      *) query_pair="$query_rest"; query_rest= ;;
    esac
    case "$query_pair" in
      "$query_wanted"=*) printf '%s' "${query_pair#*=}"; return 0 ;;
    esac
  done
}

# Подоболочка, чтобы загруженные здесь P_/M_/S_ не протекали в вызывающий код.
profile_detail_json() (
  view_id="$1"
  profile_file "$view_id" >/dev/null || return 1
  profile_bundle_load "$view_id"
  view_source="$PROFILES_DIR/$view_id.source.yaml"
  view_final="$RUNTIME_DIR/$view_id.config.yaml"
  view_error="$ERRORS_DIR/$view_id.txt"
