# Меняет только активный профиль и флаг запуска, всё остальное переносит
# как есть. Перечитывает состояние под блокировкой, иначе параллельное
# "Сохранить настройки" будет затёрто целиком.
write_state() {
  ws_active="$1" ws_run="$2"
  state_lock
  state_load
  tmp_state="$RUNTIME_DIR/state.cgi.$$"
  umask 077
  {
    printf 'STATE_VERSION=5\n'
    printf 'ACTIVE_PROFILE_ID=%s\n' "$ws_active"
    printf 'RUN_ENABLED=%s\n' "$ws_run"
    printf 'GLOBAL_HEADERS_B64=%s\n' "$ST_GLOBAL_HEADERS_B64"
    printf 'LISTENER_MODE=%s\n' "$ST_LISTENER_MODE"
    printf 'REDIR_PORT=%s\n' "$ST_REDIR_PORT"
    printf 'TPROXY_PORT=%s\n' "$ST_TPROXY_PORT"
    printf 'MIHOMO_FIND_PROCESS_MODE=%s\n' "$ST_MIHOMO_FIND_PROCESS_MODE"
    printf 'MIHOMO_LOG_LEVEL=%s\n' "$ST_MIHOMO_LOG_LEVEL"
    printf 'MIHOMO_IPV6=%s\n' "$ST_MIHOMO_IPV6"
    printf 'MIHOMO_STORE_SELECTED=%s\n' "$ST_MIHOMO_STORE_SELECTED"
    printf 'MIHOMO_STORE_FAKE_IP=%s\n' "$ST_MIHOMO_STORE_FAKE_IP"
    printf 'MIHOMO_SNIFFER_OVERRIDE=%s\n' "$ST_MIHOMO_SNIFFER_OVERRIDE"
    printf 'MIHOMO_SNIFFER_ENABLE=%s\n' "$ST_MIHOMO_SNIFFER_ENABLE"
    printf 'MIHOMO_SNIFFER_FORCE_DNS_MAPPING=%s\n' "$ST_MIHOMO_SNIFFER_FORCE_DNS_MAPPING"
    printf 'MIHOMO_SNIFFER_PARSE_PURE_IP=%s\n' "$ST_MIHOMO_SNIFFER_PARSE_PURE_IP"
    printf 'MIHOMO_SNIFFER_OVERRIDE_DESTINATION=%s\n' "$ST_MIHOMO_SNIFFER_OVERRIDE_DESTINATION"
    emit_state_tail
  } > "$tmp_state"
  if ! persist_file_if_changed "$tmp_state" "$STATE"; then
    state_unlock
    deny 'could not save runtime state'
  fi
  state_unlock
}

