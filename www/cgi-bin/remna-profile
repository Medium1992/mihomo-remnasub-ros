[ "${#headers}" -le 16384 ] || deny 'Headers are too large'
valid_header_block "$headers" || deny 'Headers contain an invalid or duplicate name'
local_override=$(printf '%s' "$local_override" | tr -d '\r')
[ -n "$name" ] || name="$target_id"
clean_name=$(printf '%s' "$name" | tr -d '\r\n')
[ "$clean_name" = "$name" ] || deny 'Profile name must be one line'
[ "${#name}" -le 80 ] || deny 'Profile name is too long'

tmp="$RUNTIME_DIR/profile.$target_id.$$"
umask 077
{
  printf 'PROFILE_VERSION=2\n'
  printf 'NAME_B64=%s\n' "$(b64 "$name")"
  printf 'SUB_URL_B64=%s\n' "$(b64 "$url")"
  printf 'SUB_HEADERS_B64=%s\n' "$(b64 "$headers")"
  printf 'LOCAL_OVERRIDE_ENABLED=%s\n' "$local_override_enabled"
  printf 'LOCAL_OVERRIDE_B64=%s\n' "$(b64 "$local_override")"
  printf 'LOCAL_FIND_PROCESS_MODE=%s\n' "$local_find_process_mode"
  printf 'LOCAL_LOG_LEVEL=%s\n' "$local_log_level"
  printf 'LOCAL_IPV6=%s\n' "$local_ipv6"
  printf 'LOCAL_STORE_SELECTED=%s\n' "$local_store_selected"
  printf 'LOCAL_STORE_FAKE_IP=%s\n' "$local_store_fake_ip"
  printf 'LOCAL_SNIFFER_MODE=%s\n' "$local_sniffer_mode"
  printf 'SUB_USE_PROVIDER_TITLE=%s\n' "$use_provider_title"
  printf 'SUB_USE_PROVIDER_INTERVAL=%s\n' "$use_provider_interval"
  printf 'SUB_REFRESH_SECONDS=%s\n' "$refresh"
  printf 'SUB_TIMEOUT_SECONDS=%s\n' "$timeout"
  printf 'SUB_INSECURE_TLS=%s\n' "$insecure"
} > "$tmp"
persist_file_if_changed "$tmp" "$target_path" || deny 'could not save profile'
new_fetch_signature="$(b64 "$url")|$(b64 "$headers")|$timeout|$insecure"
new_build_signature="$local_override_enabled|$(b64 "$local_override")|$local_find_process_mode|$local_log_level|$local_ipv6|$local_store_selected|$local_store_fake_ip|$local_sniffer_mode"
queued=false
queued_action=
if [ -n "$url" ] && { [ "$old_fetch_signature" != "$new_fetch_signature" ] || [ ! -s "$PROFILES_DIR/$target_id.source.yaml" ]; }; then
  queue_profile_job "$target_id" fetch "subscription source settings changed"
  queued=true
  queued_action=fetch
elif [ "$old_build_signature" != "$new_build_signature" ] && [ -s "$PROFILES_DIR/$target_id.source.yaml" ]; then
  queue_profile_job "$target_id" rebuild "subscription overrides changed"
  queued=true
  queued_action=rebuild
fi
json_headers
printf '{"ok":true,"queued":%s,"queued_action":"%s"}\n' "$queued" "$queued_action"
