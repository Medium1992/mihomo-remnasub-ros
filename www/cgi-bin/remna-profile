    view_updated_at="$M_fetched_epoch"
    [ "$view_updated_at" != 0 ] || view_updated_at=$(stat -c '%Y' "$view_source" 2>/dev/null || printf '0')
    valid_number "$view_updated_at" || view_updated_at=0
  fi
  view_final_updated_at=$(stat -c '%Y' "$view_final" 2>/dev/null || printf '0')
  valid_number "$view_final_updated_at" || view_final_updated_at=0

  printf '{'
  printf '"id":"%s",' "$view_id"
  printf '"name_b64":"%s",' "${P_NAME_B64:-$(b64 "$view_id")}"
  printf '"display_name_b64":"%s",' "$(effective_name_b64 "$view_id")"
  printf '"url_b64":"%s",' "$P_SUB_URL_B64"
  printf '"headers_b64":"%s",' "$P_SUB_HEADERS_B64"
  printf '"local_override_enabled":%s,' "$P_LOCAL_OVERRIDE_ENABLED"
  printf '"local_override_b64":"%s",' "$P_LOCAL_OVERRIDE_B64"
  printf '"local_find_process_mode":"%s",' "$P_LOCAL_FIND_PROCESS_MODE"
  printf '"local_log_level":"%s",' "$P_LOCAL_LOG_LEVEL"
  printf '"local_ipv6":"%s",' "$P_LOCAL_IPV6"
  printf '"local_store_selected":"%s",' "$P_LOCAL_STORE_SELECTED"
  printf '"local_store_fake_ip":"%s",' "$P_LOCAL_STORE_FAKE_IP"
  printf '"local_sniffer_mode":"%s",' "$P_LOCAL_SNIFFER_MODE"
  printf '"use_provider_title":%s,' "$(bool_or "$P_SUB_USE_PROVIDER_TITLE" 1)"
  printf '"use_provider_interval":%s,' "$(bool_or "$P_SUB_USE_PROVIDER_INTERVAL" 1)"
  printf '"refresh_seconds":%s,' "$(number_or "$P_SUB_REFRESH_SECONDS" 3600)"
  printf '"effective_refresh_seconds":%s,' "$(effective_refresh)"
  printf '"timeout_seconds":%s,' "$(number_or "$P_SUB_TIMEOUT_SECONDS" 30)"
  printf '"insecure_tls":%s,' "$(bool_or "$P_SUB_INSECURE_TLS" 0)"
  printf '"provider_title_b64":"%s",' "$M_provider_title_b64"
  printf '"provider_refresh_seconds":%s,' "$(number_or "$M_provider_refresh_seconds" 0)"
  printf '"subscription_userinfo_b64":"%s",' "$M_subscription_userinfo_b64"
  printf '"profile_web_page_url_b64":"%s",' "$M_profile_web_page_url_b64"
  printf '"support_url_b64":"%s",' "$M_support_url_b64"
  printf '"subscription_refill_date_b64":"%s",' "$M_subscription_refill_date_b64"
  printf '"announce_b64":"%s",' "$M_announce_b64"
  printf '"source_present":%s,' "$view_source_present"
  printf '"final_present":%s,' "$view_final_present"
  printf '"updated_at":%s,' "$view_updated_at"
  printf '"final_updated_at":%s,' "$view_final_updated_at"
  printf '"configuration_valid":"%s",' "$M_configuration_valid"
  printf '"http_status":"%s",' "$M_http_status"
  printf '"http_status_line_b64":"%s",' "$M_http_status_line_b64"
