#!/bin/sh
. /www/cgi-bin/_remna.sh

profile_local_override_enabled() {
  local_file="$1"
  local_enabled=$(state_file_get "$local_file" LOCAL_OVERRIDE_ENABLED missing)
  if [ "$local_enabled" = missing ]; then
    [ -n "$(state_file_get "$local_file" LOCAL_OVERRIDE_B64)" ] && local_enabled=1 || local_enabled=0
  fi
  case "$local_enabled" in 0|1) ;; *) local_enabled=0 ;; esac
  printf '%s' "$local_enabled"
}

profile_meta_get() {
  meta_file="$1" meta_key="$2" meta_fallback="${3:-}"
  state_file_get "$meta_file" "$meta_key" "$meta_fallback"
}

profile_effective_name_b64() {
  effective_file="$1" effective_meta="$2"
  local_name=$(state_file_get "$effective_file" NAME_B64 "$(b64 "${effective_file##*/}")")
  use_provider_title=$(state_file_get "$effective_file" SUB_USE_PROVIDER_TITLE 1)
  provider_title=$(profile_meta_get "$effective_meta" provider_title_b64)
  if [ "$use_provider_title" = 1 ] && [ -n "$provider_title" ]; then
    printf '%s' "$provider_title"
  else
    printf '%s' "$local_name"
  fi
}

profile_effective_refresh() {
  effective_file="$1" effective_meta="$2"
  refresh=$(state_file_get "$effective_file" SUB_REFRESH_SECONDS 3600)
  valid_number "$refresh" && [ "$refresh" -ge 30 ] && [ "$refresh" -le 86400 ] || refresh=3600
  if [ "$(state_file_get "$effective_file" SUB_USE_PROVIDER_INTERVAL 1)" = 1 ]; then
    provider_refresh=$(profile_meta_get "$effective_meta" provider_refresh_seconds)
    if valid_number "$provider_refresh" && [ "$provider_refresh" -ge 30 ] && [ "$provider_refresh" -le 86400 ]; then
      refresh="$provider_refresh"
    fi
  fi
  printf '%s' "$refresh"
}

number_or() {
  number_value="$1" number_fallback="$2"
  valid_number "$number_value" && printf '%s' "$number_value" || printf '%s' "$number_fallback"
}

bool_or() {
  bool_value="$1" bool_fallback="$2"
  case "$bool_value" in 0|1) printf '%s' "$bool_value" ;; *) printf '%s' "$bool_fallback" ;; esac
}

valid_header_block() {
  printf '%s\n' "${1:-}" | awk '
    function trim(value) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); return value }
    {
      sub(/\r$/, "")
      if ($0 ~ /^[[:space:]]*$/) next
      separator = index($0, ":")
      if (separator < 2) exit 1
      key = trim(substr($0, 1, separator - 1))
      if (key !~ /^[A-Za-z0-9-]+$/) exit 1
      key = tolower(key)
      if (seen[key]++) exit 1
    }
  '
}

sniffer_override_value() {
  configured=$(state_file_get "$STATE" MIHOMO_SNIFFER_OVERRIDE)
  case "$configured" in 0|1) printf '%s' "$configured"; return 0 ;; esac
  printf '0'
}

valid_port_block() {
  printf '%s' "${1:-}" | tr ',' '\n' | awk '
    function trim(value) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); return value }
    {
      value=trim($0)
      if (value == "") next
      if (value ~ /^[0-9]+$/) {
        number=value + 0
        if (number < 1 || number > 65535) exit 1
        next
      }
      if (value ~ /^[0-9]+-[0-9]+$/) {
        split(value, range, "-")
        start=range[1] + 0
        finish=range[2] + 0
        if (start < 1 || finish > 65535 || start > finish) exit 1
        next
      }
      exit 1
    }
  '
}

profiles_json() {
  first=1
  for file in "$PROFILES_DIR"/p-*.conf; do
    [ -f "$file" ] || continue
    id=${file##*/}
    id=${id%.conf}
    profile_source="$PROFILES_DIR/$id.source.yaml"
    profile_final="$RUNTIME_DIR/$id.config.yaml"
    profile_error="$PROFILES_DIR/$id.error.txt"
    profile_meta="$PROFILES_DIR/$id.source.meta"
    source_present=false
    final_present=false
    updated_at=0
    [ -s "$profile_source" ] && source_present=true
    [ -s "$profile_final" ] && final_present=true
    if [ -f "$profile_source" ]; then
      updated_at=$(stat -c '%Y' "$profile_source" 2>/dev/null || printf '0')
    fi
    [ "$first" = 1 ] || printf ','
    first=0
    printf '{"id":"%s","name_b64":"%s","display_name_b64":"%s","url_b64":"%s","refresh_seconds":%s,"effective_refresh_seconds":%s,"local_override_enabled":%s,"source_present":%s,"final_present":%s,"updated_at":%s,"error_b64":"%s"}' \
      "$id" \
      "$(state_file_get "$file" NAME_B64 "$(b64 "$id")")" \
      "$(profile_effective_name_b64 "$file" "$profile_meta")" \
      "$(state_file_get "$file" SUB_URL_B64)" \
      "$(number_or "$(state_file_get "$file" SUB_REFRESH_SECONDS 3600)" 3600)" \
      "$(profile_effective_refresh "$file" "$profile_meta")" \
      "$(profile_local_override_enabled "$file")" \
      "$source_present" \
      "$final_present" \
      "$updated_at" \
      "$(b64 "$(cat "$profile_error" 2>/dev/null || true)")"
  done
}

